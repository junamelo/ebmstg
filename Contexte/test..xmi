<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI
    xmi:version="2.1"
    xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
    xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

    <uml:Model
        xmi:id="model_portail_facturation"
        name="Portail de Facturation Moov Africa">

        <!-- ================================================= -->
        <!-- SYSTEME / FRONTIERE DU SYSTEME                   -->
        <!-- ================================================= -->

        <packagedElement
            xmi:type="uml:Package"
            xmi:id="package_portail"
            name="Portail de Facturation Moov Africa">

            <!-- ================================================= -->
            <!-- ACTEURS                                            -->
            <!-- ================================================= -->

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_admin"
                name="Super Admin"/>

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_chef"
                name="Chef Facturation"/>

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_agent"
                name="Agent Facturation"/>

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_payeur"
                name="Payeur"/>

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_employe"
                name="Employé"/>

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_email"
                name="Système Email"/>

            <packagedElement
                xmi:type="uml:Actor"
                xmi:id="actor_sms"
                name="Système SMS"/>


            <!-- ================================================= -->
            <!-- CAS D'UTILISATION                                  -->
            <!-- ================================================= -->

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC1"
                name="Créer utilisateur"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC2"
                name="Modifier statut utilisateur"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC3"
                name="Réinitialiser mot de passe"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC4"
                name="Créer contrat"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC5"
                name="Modifier contrat"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC6"
                name="Résilier contrat"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC7"
                name="Ajouter ligne téléphonique"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC8"
                name="Modifier services ligne"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC9"
                name="Affecter employé à ligne"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC10"
                name="Publier factures PDF"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC11"
                name="Annuler facture"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC12"
                name="Consulter factures"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC13"
                name="Télécharger PDF"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC14"
                name="Exporter données"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC15"
                name="Gérer forfaits"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC16"
                name="Gérer services"/>

            <packagedElement
                xmi:type="uml:UseCase"
                xmi:id="UC17"
                name="Consulter statistiques"/>

            <packagedElement

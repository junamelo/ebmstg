' Diagrammes de cas d'utilisation - Moov e-Factures
' Version corrigée selon le cours UML : vue métier, cas essentiels,
' associations simples, <<include>> obligatoire et <<extend>> optionnel.

@startuml Administrateur
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
actor "Administrateur" as admin
rectangle "Moov e-Factures" {
  usecase "S'authentifier" as admLogin
  usecase "Consulter le tableau\nde bord" as admDashboard
  usecase "Gérer les comptes\nutilisateurs" as admComptes
  usecase "Gérer les rôles et\npermissions" as admRoles
  usecase "Gérer le catalogue\nforfaits et services" as admCatalogue
  usecase "Gérer les contrats" as admContrats
  usecase "Traiter un bloc\nde factures PDF" as admPdf
  usecase "Publier des factures" as admPublier
  usecase "Consulter l'historique\nde publication" as admHistorique
  usecase "Exporter un contrat\nau format PDF" as admExport
  usecase "Consulter les journaux\net statistiques" as admSuivi
  usecase "Réinitialiser un\nmot de passe" as admMdp
  usecase "Gérer son profil\net le 2FA" as admProfil
}
admin -- admLogin
admin -- admDashboard
admin -- admComptes
admin -- admRoles
admin -- admCatalogue
admin -- admContrats
admin -- admPdf
admin -- admPublier
admin -- admHistorique
admin -- admExport
admin -- admSuivi
admin -- admProfil
admMdp .> admComptes : <<extend>>
@enduml

' Diagramme global : les deux rôles de facturation partagent les cas communs.
' Le Chef et l'Agent sont spécialisés à partir de l'opérateur de facturation.
@startuml FacturationChefAgent
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Opérateur de facturation" as operateur <<abstract>>
actor "Agent de facturation" as agentGlobal
actor "Chef de facturation" as chefGlobal
actor "Service e-mail SMTP" as smtpGlobal <<système externe>>

agentGlobal -|> operateur
chefGlobal -|> operateur

rectangle "Moov e-Factures" {
  usecase "S'authentifier" as uLogin
  usecase "Gérer son profil\net le 2FA" as uProfil
  usecase "Gérer les contrats" as uContrats
  usecase "Gérer les lignes\ndu contrat" as uLignes
  usecase "Affecter un employé\nà une ligne" as uAffecter
  usecase "Gérer les services\nd'une ligne" as uServices
  usecase "Gérer les commerciaux" as uCommerciaux
  usecase "Gérer les payeurs\net les employés" as uComptesClients
  usecase "Gérer les forfaits,\nservices et tarifs" as uCatalogue

  usecase "Traiter une demande\nde contrat" as uDemande <<abstract>>
  usecase "Valider une demande\nde contrat" as uValider
  usecase "Rejeter une demande\nde contrat" as uRejeter
  usecase "Consulter le détail\nde la demande" as uDetail
  usecase "Saisir le motif\nde rejet" as uMotif

  usecase "Traiter un bloc\nde factures PDF" as uPdf
  usecase "Suivre le traitement\ndu bloc PDF" as uSuiviPdf
  usecase "Publier des factures" as uPublier
  usecase "Envoyer une notification\npar e-mail" as uEmail
  usecase "Consulter l'historique\nde publication" as uHistorique
  usecase "Exporter un contrat\nau format PDF" as uExport
  usecase "Consulter le tableau\nde bord" as uDashboard
  usecase "Gérer les agents\nde facturation" as uAgents
}

' Cas communs hérités par l'Agent et le Chef.
operateur -- uLogin
operateur -- uProfil
operateur -- uContrats
operateur -- uLignes
operateur -- uCommerciaux
operateur -- uComptesClients
operateur -- uCatalogue
operateur -- uDemande
operateur -- uPdf
operateur -- uSuiviPdf
operateur -- uPublier
operateur -- uHistorique
operateur -- uExport
operateur -- uDashboard

' Fonctionnalité réservée au Chef de facturation.
chefGlobal -- uAgents

smtpGlobal -- uEmail

' Sous-fonctions et extensions.
uAffecter .> uLignes : <<extend>>
uServices .> uLignes : <<extend>>
uValider -|> uDemande
uRejeter -|> uDemande
uDemande .> uDetail : <<include>>
uRejeter .> uMotif : <<include>>
uEmail .> uPublier : <<extend>>

note right of uEmail
  Seulement si l'option e-mail
  est sélectionnée lors de la publication.
end note
@enduml


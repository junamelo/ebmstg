# Production : definir une cle Django longue et aleatoire, ne jamais versionner .env
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Notifications de factures (laisser vides tant que les comptes ne sont pas fournis)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_FROM=
